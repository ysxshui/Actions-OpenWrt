如何在P3TERX/OpenWrt项目中替换.config文件并编译# x86 目标设备配置
CONFIG_TARGET_x86_64=y
CONFIG_TARGET_x86_64_generic=y

# 选择内核版本
CONFIG_KERNEL_VERSION="5.10"

# 启用必要的硬件支持（CPU，驱动等）
CONFIG_PACKAGE_kmod-fs-ext4=y
CONFIG_PACKAGE_kmod-usb2=y
CONFIG_PACKAGE_kmod-usb3=y
CONFIG_PACKAGE_kmod-usb-net=y
CONFIG_PACKAGE_kmod-usb-net-rtl8150=y

# 启用 Realtek 8125/8156B 网卡驱动
CONFIG_PACKAGE_kmod-r8169=y

# 开启 Passwall、SSR+、Passwall2 插件
CONFIG_PACKAGE_luci-app-passwall=y
CONFIG_PACKAGE_luci-app-passwall2=y
CONFIG_PACKAGE_luci-app-ssr-plus=y
CONFIG_PACKAGE_passwall=y
CONFIG_PACKAGE_passwall2=y
CONFIG_PACKAGE_ssr-plus=y

# 启用 Bypass 插件
CONFIG_PACKAGE_luci-app-bypass=y
CONFIG_PACKAGE_bypass=y

# DDNS 插件
CONFIG_PACKAGE_luci-app-ddns-go=y
CONFIG_PACKAGE_ddns-go=y

# UDPxy 插件
CONFIG_PACKAGE_luci-app-udpxy=y
CONFIG_PACKAGE_udpxy=y

# KMS 激活工具
CONFIG_PACKAGE_luci-app-kms=y
CONFIG_PACKAGE_kms-server=y

# 网络唤醒功能
CONFIG_PACKAGE_luci-app-wol=y
CONFIG_PACKAGE_etherwake=y

# 设置中文环境
CONFIG_LUCI_LANG_zh-cn=y
CONFIG_LUCI_DEFAULT_LANG="zh-cn"

# 设置默认管理员密码
CONFIG_DEFAULT_ADMIN_PASSWORD="dfxcw+042325wzmlbjl1f$"

# 网络接口配置
# LAN口配置（eth0, eth2, eth3）
config interface 'lan'
    option type 'bridge'
    option ifname 'eth0 eth2 eth3'
    option proto 'static'
    option ipaddr '192.168.100.252'  # LAN 地址修改为 192.168.100.252
    option netmask '255.255.255.0'

# WAN口配置（eth1）
config interface 'wan'
    option ifname 'eth1'
    option proto 'pppoe'
    option username 'sza100980742'  # PPPoE 拨号账号
    option password '277996'        # PPPoE 拨号密码
    option ipv6 'auto'

# IPTV口配置（eth4）
config interface 'iptv'
    option ifname 'eth4'
    option proto 'pppoe'
    option username 'szi221008230847@iptv'  # IPTV PPPoE 拨号账号
    option password '456123'                # IPTV PPPoE 拨号密码
    option ipv6 'auto'